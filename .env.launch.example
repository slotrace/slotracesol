# Copy to .env.launch.local; never commit the copy.
# The private RPC can stay in .env.local (SOLANA_RPC_URL).
CLOUDFLARE_ACCOUNT_ID=
# Use an API token scoped to this account/Worker with Workers Scripts Write.
# No wallet key or seed phrase is used by the monitor.
CLOUDFLARE_API_TOKEN=
# Optional: fine-grained GitHub token with Contents write for slotrace/slotracesol.
# Leave empty to update README through the connected GitHub app in this chat.
GITHUB_TOKEN=
